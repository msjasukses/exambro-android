# Salin file ini menjadi keystore.properties lalu isi sesuai keystore Anda.
# JANGAN commit keystore.properties maupun berkas .jks ke repositori.
# storeFile relatif terhadap root project (C:\laragon\www\exbro).
storeFile=exbro-release.jks
storePassword=ISI_PASSWORD_KEYSTORE
keyAlias=exbro
